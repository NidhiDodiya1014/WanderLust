<% layout('layouts/boilerplate') %>

<div class="container" style="text-align: center; padding: 5rem 2rem;">
    <div style="font-size: 5rem; margin-bottom: 1rem; color: var(--primary);">
        <i class="fas fa-exclamation-circle"></i>
    </div>
    <h1 style="font-size: 3rem; margin-bottom: 1rem;"><%= errorCode %></h1>
    <p style="font-size: 1.2rem; color: var(--text-secondary); margin-bottom: 2rem;"><%= errorMessage %></p>
    <a href="/listings" class="btn btn-primary">
        <i class="fas fa-home"></i> Go Home
    </a>
</div>
